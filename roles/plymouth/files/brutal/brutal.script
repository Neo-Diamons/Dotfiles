Window.SetBackgroundTopColor(0.098, 0.098, 0.098);
Window.SetBackgroundBottomColor(0.098, 0.098, 0.098);

bar_bg = Image("bar-bg.png");
bar_fill = Image("bar-fill.png");
label = Image("label.png");

main = 0;
main_width = Window.GetWidth(0);
for (i = 1; i < 4; i++) {
  candidate = Window.GetWidth(i);
  if (candidate > main_width) {
    main = i;
    main_width = candidate;
  }
}

center_x = Window.GetX(main) + main_width / 2;
center_y = Window.GetY(main) + Window.GetHeight(main) / 2;

bar_x = center_x - bar_bg.GetWidth() / 2;
bar_y = center_y;
inner_x = bar_x + 6;
inner_y = bar_y + 4;

label_sprite = Sprite(label);
label_sprite.SetPosition(center_x - label.GetWidth() / 2, bar_y - label.GetHeight() - 24, 1);

bar_sprite = Sprite(bar_bg);
bar_sprite.SetPosition(bar_x, bar_y, 1);

fill_sprite = Sprite();
fill_sprite.SetPosition(inner_x, inner_y, 2);

fun progress_callback(duration, progress) {
  width = Math.Int(bar_fill.GetWidth() * progress);
  if (width < 1)
    width = 1;
  fill_sprite.SetImage(bar_fill.Scale(width, bar_fill.GetHeight()));
}

block_width = 80;
period = 160;
frame = 0;

fun sweep_callback() {
  frame++;
  phase = frame % period;
  if (phase > period / 2)
    phase = period - phase;
  fill_sprite.SetX(inner_x + Math.Int((bar_fill.GetWidth() - block_width) * phase / (period / 2)));
}

if (Plymouth.GetMode() == "boot") {
  Plymouth.SetBootProgressFunction(progress_callback);
} else {
  fill_sprite.SetImage(bar_fill.Scale(block_width, bar_fill.GetHeight()));
  Plymouth.SetRefreshFunction(sweep_callback);
}
