-- Cursor
hl.env("XCURSOR_THEME", "{{ cursor_theme_name }}")
hl.env("XCURSOR_SIZE", "{{ cursor_theme_size }}")
hl.env("HYPRCURSOR_SIZE", "{{ cursor_theme_size }}")

{% if gpu == 'nvidia' %}
-- NVIDIA Wayland optimizations
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")

{% endif %}
hl.env("EDITOR", "vis")

hl.env("PATH", os.getenv("HOME") .. "/.local/bin:" .. os.getenv("HOME") .. "/.cargo/bin:" .. os.getenv("PATH"))

hl.env("XDG_DATA_DIRS", os.getenv("HOME") .. "/.local/share:/usr/local/share:/usr/share:/var/lib/flatpak/exports/share")
hl.env("QT_QPA_PLATFORMTHEME", "gtk3")
