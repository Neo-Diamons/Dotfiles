hl.on("hyprland.start", function()
    hl.exec_cmd("hyprctl setcursor {{ cursor_theme_name }} {{ cursor_theme_size }}")
    hl.exec_cmd("udiskie --no-tray")
    hl.exec_cmd("$HOME/.config/hypr/scripts/random-wallpaper.sh")
    hl.exec_cmd("quickshell")
    hl.exec_cmd("hypridle")
{% if sunshine %}
    hl.exec_cmd("sunshine")
{% endif %}
{% if not laptop %}
    hl.exec_cmd("flatpak run com.valvesoftware.Steam -silent")
{% endif %}
{% if autostart_discord %}
    hl.exec_cmd("flatpak run com.discordapp.Discord --start-minimized --ozone-platform=x11 >/tmp/discord.log 2>&1")
{% endif %}
end)
