// qmllint disable Quick.color

pragma Singleton
import QtQuick
import Quickshell

// Palette generated by wallust from this template
Singleton {
    // Base surfaces
    readonly property color bgBase: "{{background}}"
    readonly property color bgSurface: "{{background | lighten(0.03)}}"
    readonly property color bgOverlay: "{{background | lighten(0.06)}}"
    readonly property color bgActive: "{{color4 | darken(0.5)}}"
    readonly property color bgHover: "{{background | lighten(0.10)}}"

    // Accents & Borders
    readonly property color accent: "{{color5}}"
    readonly property color borderMuted: "{{background | lighten(0.06)}}"
    readonly property color borderDefault: "{{background | lighten(0.10)}}"
    readonly property color borderFocused: "{{color5}}"
    readonly property color borderActive: "{{color3}}"

    // Typography
    readonly property color textPrimary: "{{foreground}}"
    readonly property color textAccent: "{{color5}}"
    readonly property color textMuted: "{{foreground | darken(0.4)}}"
    readonly property color textSubtle: "{{foreground | darken(0.2)}}"

    // Status / Urgency
    readonly property color urgent: "{{color1}}"
    readonly property color warning: "{{color3}}"
    readonly property color info: "{{color6}}"
}
