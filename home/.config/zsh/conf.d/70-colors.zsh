# Colours: syntax highlighting (palette-following)
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES=(
  default               'none'
  unknown-token         'fg=1'
  reserved-word         'fg=5'
  alias                 'fg=2'
  builtin               'fg=2'
  function              'fg=2'
  command               'fg=2'
  precommand            'fg=2,underline'
  arg0                  'fg=2'
  commandseparator      'fg=5'
  redirection           'fg=5'
  path                  'underline'
  globbing              'fg=4'
  assign                'fg=4'
  single-hyphen-option  'fg=6'
  double-hyphen-option  'fg=6'
  single-quoted-argument 'fg=3'
  double-quoted-argument 'fg=3'
  dollar-quoted-argument 'fg=3'
  back-quoted-argument  'fg=5'
  comment               'fg=8'
)
