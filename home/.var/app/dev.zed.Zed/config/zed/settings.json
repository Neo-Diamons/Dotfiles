// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "ui_font_family": "monospace",
  "buffer_font_family": "monospace",
  "terminal": {
    "font_family": "monospace",
    "flexible": true,
    "dock": "bottom",
  },
  "icon_theme": "Gruvbox Material Icon Theme",
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "debugger": {
    "dock": "right",
    "button": true,
  },
  "search": {
    "button": false,
  },
  "tabs": {
    "close_position": "right",
  },
  "window_decorations": "client",
  "title_bar": {
    "show_sign_in": false,
    "button_layout": "platform_default",
  },
  "project_panel": {
    "dock": "left",
    "button": true,
  },
  "format_on_save": "modifications_if_available",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "collaboration_panel": {
    "button": false,
  },
  "disable_ai": true,
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "auto_install_extensions": {
    "ansible": true,
    "git-firefly": true,
    "html": true,
    "jinja2": true,
    "lua": true,
    "qml": true,
    "svelte": true,
    "toml": true,
  },
}
